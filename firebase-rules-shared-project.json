{
  "rules": {
    ".read": false,
    ".write": false,

    "allowed": {
      ".read": "auth != null",
      ".write": false
    },

    "data": {
      ".read":  "auth != null && root.child('allowed').child(auth.uid).exists()",
      ".write": "auth != null && root.child('allowed').child(auth.uid).exists()",

      "medicine": {

        "public": {
          ".read": true
        },

        "inbox": {
          "$ref": {
            ".write": "!data.exists()",
            ".validate": "$ref.matches(/^REQ-[0-9]{8}-[A-Z0-9]{4}$/) && newData.hasChildren(['ref','name','org','license','phone','email','startUse','items','createdAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 120 && newData.child('org').isString() && newData.child('org').val().length <= 200 && newData.child('license').isString() && newData.child('license').val().length <= 100 && newData.child('phone').isString() && newData.child('phone').val().length <= 40 && newData.child('email').isString() && newData.child('email').val().matches(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/) && newData.child('email').val().length <= 120 && (!newData.hasChild('note') || newData.child('note').val().length <= 2000) && (!newData.hasChild('studyTitle') || newData.child('studyTitle').val().length <= 300) && (!newData.hasChild('addr') || newData.child('addr').val().length <= 300)"
          }
        }

      },

      "equipment": {

        "list":     { ".read": "auth != null" },
        "settings": { ".read": "auth != null" },

        "users": {
          "$uid": {
            ".read":  "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid",
            "name":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "email": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "org":   { ".validate": "newData.isString() && newData.val().length <= 200" },
            "phone": { ".validate": "newData.isString() && newData.val().length <= 40" }
          }
        },

        "trained": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid"
          }
        },

        "bookings": {
          "$uid": {
            ".read":  "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid",
            "$bk": {
              ".validate": "$bk.matches(/^BK-[0-9]{8}-[A-Z0-9]{4}$/) && newData.hasChildren(['id','uid','eqId','dates','start','end','status','createdAt'])",
              "uid":     { ".validate": "newData.val() == $uid" },
              "id":      { ".validate": "newData.val() == $bk" },
              "email":   { ".validate": "newData.isString() && newData.val().length <= 120" },
              "purpose": { ".validate": "newData.isString() && newData.val().length <= 300" },
              "note":    { ".validate": "newData.isString() && newData.val().length <= 1000" },
              "start":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)" },
              "end":     { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)" },
              "status":  { ".validate": "root.child('allowed').child(auth.uid).exists() || (!data.exists() && newData.val() == 'pending') || (!data.exists() && newData.val() == 'done' && newData.parent().child('walkin').val() == true && newData.parent().hasChild('usage')) || newData.val() == 'cancelled' || newData.val() == data.val() || (newData.val() == 'done' && data.val() == 'approved')" },
              "walkin":  { ".validate": "newData.isBoolean() && (root.child('allowed').child(auth.uid).exists() || !data.exists() || newData.val() == data.val())" },
              "ackAt":   { ".validate": "root.child('allowed').child(auth.uid).exists() || newData.val() == data.val()" },
              "ackBy":   { ".validate": "root.child('allowed').child(auth.uid).exists() || newData.val() == data.val()" }
            }
          }
        },

        "faults": {
          "$uid": {
            ".read":  "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid",
            "$fl": {
              ".validate": "$fl.matches(/^FL-[0-9]{8}-[A-Z0-9]{4}$/) && newData.hasChildren(['id','uid','eqId','symptom','status','createdAt'])",
              "uid":      { ".validate": "newData.val() == $uid" },
              "id":       { ".validate": "newData.val() == $fl" },
              "symptom":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
              "detail":   { ".validate": "newData.isString() && newData.val().length <= 2000" },
              "severity": { ".validate": "newData.val() == 'unusable' || newData.val() == 'partial' || newData.val() == 'minor'" },
              "status":   { ".validate": "root.child('allowed').child(auth.uid).exists() || (!data.exists() && newData.val() == 'open') || newData.val() == data.val()" },
              "log":      { ".validate": "root.child('allowed').child(auth.uid).exists() || !data.exists()" },
              "closedAt": { ".validate": "root.child('allowed').child(auth.uid).exists()" },
              "closedBy": { ".validate": "root.child('allowed').child(auth.uid).exists()" }
            }
          }
        },

        "slots": {
          ".read": "auth != null",
          "$eq": {
            "$date": {
              "$slot": {
                ".write": "auth != null && ( (!data.exists() && newData.child('u').val() == auth.uid) || (data.exists() && data.child('u').val() == auth.uid) || root.child('allowed').child(auth.uid).exists() )",
                ".validate": "newData.hasChildren(['u','b']) && $date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $slot.matches(/^[0-9]{4}$/) && newData.child('b').val().matches(/^BK-[0-9]{8}-[A-Z0-9]{4}$/)"
              }
            }
          }
        }

      },

      "animalReport": {
        ".read":  "auth != null && root.child('allowed').child(auth.uid).exists()",
        ".write": "auth != null && root.child('allowed').child(auth.uid).exists()",
  
        "projects": {
          ".read": "auth != null",
          "$pid": {
            ".validate": "newData.hasChildren(['id','projectNo','projectName']) && newData.child('id').val() == $pid && newData.child('projectNo').isString() && newData.child('projectNo').val().length > 0 && newData.child('projectNo').val().length <= 80 && newData.child('projectName').isString() && newData.child('projectName').val().length <= 300",
            "piName":  { ".validate": "newData.isString() && newData.val().length <= 150" },
            "piEmail": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "species": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "strain":  { ".validate": "newData.isString() && newData.val().length <= 120" },
            "approved": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" }
          }
        },
  
        "users": {
          "$uid": {
            ".read":  "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['name','email'])",
            "name":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "email":     { ".validate": "newData.isString() && newData.val().length <= 120" },
            "org":       { ".validate": "newData.isString() && newData.val().length <= 200" },
            "phone":     { ".validate": "newData.isString() && newData.val().length <= 40" },
            "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other":    { ".validate": false }
          }
        },
  
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            "status": { ".validate": "newData.val().matches(/^(approved|rejected|suspended|pending)$/)" }
          }
        },
  
        "reports": {
          "$uid": {
            ".read":  "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid && root.child('data').child('animalReport').child('members').child(auth.uid).child('status').val() == 'approved'",
            "$rid": {
              ".validate": "newData.hasChildren(['id','projectNo','species','qty','action','actionDate','reporter']) && newData.child('id').val() == $rid && newData.child('uid').val() == $uid && newData.child('action').val().matches(/^(euthanasia|offsite|died)$/) && newData.child('actionDate').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('qty').isNumber() && newData.child('qty').val() > 0 && newData.child('qty').val() <= 100000",
              "docNo":      { ".validate": "newData.isString() && newData.val().length <= 40" },
              "projectNo":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              "species":    { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
              "strain":     { ".validate": "newData.isString() && newData.val().length <= 120" },
              "sex":        { ".validate": "newData.isString() && newData.val().length <= 60" },
              "reporter":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150" },
              "euthMethod": { ".validate": "newData.val().matches(/^(Overdose anesthetic drug injection|Overdose anesthetic drug inhalation|Carbondioxide inhalation)$/)" },
              "note":       { ".validate": "newData.isString() && newData.val().length <= 3000" }
            }
          }
        },
  
        "alerts": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            "$aid": {
              ".write": "auth != null && auth.uid == $uid && newData.exists() && root.child('data').child('animalReport').child('members').child(auth.uid).child('status').val() == 'approved'",
              ".validate": "newData.hasChildren(['id','uid','docNo','type','urgency','status','species','qty','location','detail','reporter','phone','createdAt']) && newData.child('id').val() == $aid && newData.child('uid').val() == $uid && newData.child('type').val().matches(/^(emergency|health)$/) && newData.child('urgency').val().matches(/^(critical|urgent|routine)$/) && newData.child('qty').isNumber() && newData.child('qty').val() > 0 && newData.child('qty').val() <= 100000",
              "status":   { ".validate": "newData.val().matches(/^(new|ack|treating|closed)$/) && (root.child('allowed').child(auth.uid).exists() || (!data.exists() && newData.val() == 'new') || newData.val() == data.val())" },
              "vetName":  { ".validate": "root.child('allowed').child(auth.uid).exists() || newData.val() == data.val()" },
              "vetNote":  { ".validate": "root.child('allowed').child(auth.uid).exists() || newData.val() == data.val()" },
              "outcome":  { ".validate": "root.child('allowed').child(auth.uid).exists() || newData.val() == data.val()" },
              "docNo":    { ".validate": "newData.isString() && newData.val().length <= 40" },
              "species":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
              "location": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
              "reporter": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150" },
              "phone":    { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
              "email":    { ".validate": "newData.isString() && newData.val().length <= 120" },
              "detail":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000" },
              "firstAid": { ".validate": "newData.isString() && newData.val().length <= 3000" },
              "photos": {
                "$i": { ".validate": "$i.matches(/^[0-2]$/) && newData.isString() && newData.val().length <= 900000 && newData.val().beginsWith('data:image/')" }
              }
            }
          }
        },
  
        "guestAlerts": {
          "$aid": {
            ".write": "!data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['id','docNo','type','urgency','status','species','qty','location','detail','reporter','phone','createdAt']) && newData.child('id').val() == $aid && $aid.matches(/^[a-z0-9]{8,20}$/) && newData.child('type').val().matches(/^(emergency|health)$/) && newData.child('urgency').val().matches(/^(critical|urgent|routine)$/) && newData.child('qty').isNumber() && newData.child('qty').val() > 0 && newData.child('qty').val() <= 100000",
            "status":   { ".validate": "newData.val().matches(/^(new|ack|treating|closed)$/) && (newData.val() == 'new' || (auth != null && root.child('allowed').child(auth.uid).exists()))" },
            "vetName":  { ".validate": "auth != null && root.child('allowed').child(auth.uid).exists()" },
            "vetNote":  { ".validate": "auth != null && root.child('allowed').child(auth.uid).exists()" },
            "outcome":  { ".validate": "auth != null && root.child('allowed').child(auth.uid).exists()" },
            "uid":      { ".validate": false },
            "docNo":    { ".validate": "newData.isString() && newData.val().length <= 40" },
            "species":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "location": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
            "reporter": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150" },
            "phone":    { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "email":    { ".validate": "newData.isString() && newData.val().length <= 120" },
            "detail":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000" },
            "firstAid": { ".validate": "newData.isString() && newData.val().length <= 3000" },
            "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "photos": {
              "$i": { ".validate": "$i.matches(/^[0-2]$/) && newData.isString() && newData.val().length <= 900000 && newData.val().beginsWith('data:image/')" }
            }
          }
        },
  
        "vets": {
          "$vid": {
            ".validate": "newData.hasChildren(['id','name']) && newData.child('id').val() == $vid",
            "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150" },
            "email":    { ".validate": "newData.isString() && newData.val().length <= 120" },
            "lineId":   { ".validate": "newData.isString() && (newData.val() == '' || newData.val().matches(/^[UCR][0-9a-f]{32}$/))" },
            "lineType": { ".validate": "newData.val().matches(/^(user|group)$/)" },
            "active":   { ".validate": "newData.isBoolean()" }
          }
        },
  
        "settings": {
          "public": {
            ".read": true,
            "emails":  { ".validate": "newData.isString() && newData.val().length <= 500" },
            "phones":  { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "hookUrl": { ".validate": "newData.isString() && newData.val().length <= 300 && (newData.val() == '' || newData.val().beginsWith('https://'))" },
            "hookKey": { ".validate": "newData.isString() && newData.val().length <= 100" }
          }
        }
      }
    }
  }
}
