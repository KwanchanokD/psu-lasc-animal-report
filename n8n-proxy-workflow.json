      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "รับคำขอจากระบบรายงานฯ",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-260, 300],
      "webhookId": "a1000000-0000-4000-8000-000000000001"
    },
    {
      "parameters": {
        "jsCode": "/* ตรวจสอบสิทธิ์และจำกัดปลายทางให้ดึงได้เฉพาะระบบจริยธรรมฯ เท่านั้น\n   ป้องกันไม่ให้พร็อกซีนี้ถูกใช้ดึงเว็บอื่น (open proxy / SSRF) */\nconst ALLOW_HOSTS = ['animalethic.research.psu.ac.th'];\nconst q = ($input.first().json.query) || {};\nconst TOKEN = $env.ANIMALETHIC_PROXY_TOKEN || '';\n\nlet target = q.url || '';\ntry { target = decodeURIComponent(target); } catch (e) {}\n\nlet ok = true;\nlet error = '';\n\nif (!TOKEN) {\n  ok = false;\n  error = 'ยังไม่ได้ตั้งค่า ANIMALETHIC_PROXY_TOKEN บนเซิร์ฟเวอร์ n8n';\n} else if (q.token !== TOKEN) {\n  ok = false;\n  error = 'token ไม่ถูกต้อง';\n}\n\nlet host = '';\nlet proto = '';\nif (ok) {\n  try {\n    const u = new URL(target);\n    host = u.hostname;\n    proto = u.protocol;\n  } catch (e) {\n    ok = false;\n    error = 'พารามิเตอร์ url ไม่ถูกต้อง';\n  }\n}\nif (ok && proto !== 'https:') {\n  ok = false;\n  error = 'อนุญาตเฉพาะ https เท่านั้น';\n}\nif (ok && !ALLOW_HOSTS.includes(host)) {\n  ok = false;\n  error = 'ไม่อนุญาตให้ดึงข้อมูลจากโดเมน: ' + host;\n}\n\nreturn [{ json: { ok, error, target } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "ตรวจสอบ token และโดเมนปลายทาง",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-40, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.ok }}",
              "value2": true
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "ผ่านการตรวจสอบหรือไม่",
