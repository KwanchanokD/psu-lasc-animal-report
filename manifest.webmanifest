{
  "id": "psu-lasc-animal-report",
  "name": "ระบบรายงานการปฏิบัติต่อสัตว์ทดลองของนักวิจัย PSU:LASC",
  "short_name": "PSU:LASC รายงาน",
  "description": "ระบบให้นักวิจัยรายงานการปฏิบัติต่อสัตว์ทดลองตามเลขที่โครงการวิจัย — การุณยฆาต (Euthanasia), การเคลื่อนย้ายออกนอกสถานที่ (Off-site transport) และสัตว์ตายระหว่างการศึกษา (Died during the study) พร้อมแจ้งเหตุฉุกเฉิน/ปัญหาสุขภาพสัตว์ถึงทีมสัตวแพทย์ — ศูนย์สัตว์ทดลอง มหาวิทยาลัยสงขลานครินทร์",
  "lang": "th",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#1a5c9e",
  "categories": ["productivity", "medical", "education"],
  "launch_handler": { "client_mode": "focus-existing" },
  "prefer_related_applications": false,
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
